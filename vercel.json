{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/webhook",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "DOMAIN": "ai.taagc.site"
  }
}
